DATABASE_URL="postgresql://user:password@localhost:5432/nfl_fantasy"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
REDIS_URL="redis://localhost:6379"

# Google sign-in (see README's "Setting up Google sign-in" section for how
# to get these from console.cloud.google.com).
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# No API key needed for scripts/load-players.ts — it uses ESPN's public
# fantasy football endpoint, which requires no authentication.
